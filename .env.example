# ==========================================
# AutoPoster Service Configuration
# ==========================================

# Server Host and Port
HOST=0.0.0.0
PORT=17420
DEBUG=true

# Instagram Meta Graph API Credentials
# (Free setup via Meta Developer App + Instagram Professional Account)
INSTAGRAM_BUSINESS_ID=your_instagram_business_id
PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here
REMOTE_HOSTING_URL=https://your-relay.example.com

# Optional Cloud Relay Deployment (PythonAnywhere API)
PYTHONANYWHERE_USERNAME=
PYTHONANYWHERE_API_TOKEN=

# Optional Long-Form AI Horror Studio Key (Experimental pipeline)
GEMINI_API_KEY=

# TikTok Credentials
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SESSION_ID=

# Smart Scheduling & Anti-Spam Jitter
# Daytime window (06:00 - 15:00) randomized cooldown range in minutes
DAY_COOLDOWN_MIN=45
DAY_COOLDOWN_MAX=70

# Peak evening window (15:00 - 24:00) randomized cooldown range in minutes
EVENING_COOLDOWN_MIN=20
EVENING_COOLDOWN_MAX=45

# Downtime Catch-up Mode
# If service was off for > 120 minutes, post a catch-up batch of up to 4 items
CATCHUP_THRESHOLD_MIN=120
MAX_CATCHUP_POSTS=4

# Remote list pull interval in minutes
PULL_INTERVAL_MIN=10
